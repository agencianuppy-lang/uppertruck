DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forcar HTTPS no dominio principal
    RewriteCond %{HTTP_HOST} ^(www\.)?uppertruck\.com$ [NC]
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Bloquear metodos perigosos
    RewriteCond %{REQUEST_METHOD} ^TRACE [NC]
    RewriteRule ^ - [F]

    # Remover barra final das URLs, exceto diretorios reais
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # Blog publico
    RewriteRule ^blog$ new-blog.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^blog/([^/]+)$ detalhe-newblog.php?slug=$1 [L,QSA]

    # Sistema/admin por URL publica unica
    RewriteRule ^sistema/assets/(.*)$ admin_blog/assets/$1 [L,QSA]
    RewriteRule ^sistema/modules/(.*)$ admin_blog/modules/$1 [L,QSA]
    RewriteRule ^sistema/calendar/(.*)$ admin_blog/calendar/$1 [L,QSA]
    RewriteRule ^sistema/auth/(.*)$ admin_blog/auth/$1 [L,QSA]
    RewriteRule ^sistema/api/(.*)$ admin_blog/api/$1 [L,QSA]
    RewriteRule ^sistema/scheduler/(.*)$ admin_blog/scheduler/$1 [L,QSA]
    RewriteRule ^sistema/uploads/(.*)$ admin_blog/uploads/$1 [L,QSA]
    RewriteRule ^sistema/vendor/(.*)$ admin_blog/vendor/$1 [L,QSA]

    # Sistema
    RewriteRule ^sistema$ sistema/index.php [L,QSA]
    RewriteRule ^sistema/$ sistema/index.php [L,QSA]
</IfModule>

<FilesMatch "^(\.env|\.git|composer\.json|composer\.lock|package\.json|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
