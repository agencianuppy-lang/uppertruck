<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    DirectoryIndex index.php index.html

    # 1. Forcar HTTPS no dominio principal
    RewriteCond %{HTTP_HOST} ^(www\.)?uppertruck\.com$ [NC]
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # 2. Bloquear metodos perigosos
    RewriteCond %{REQUEST_METHOD} ^TRACE [NC]
    RewriteRule ^ - [F]

    # 3. Remover barra final das URLs, exceto diretorios reais
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ $1 [R=301,L]

    # 4. Home do site novo
    RewriteRule ^$ index.php [L,QSA]
    RewriteRule ^index\.php$ index.php [L,QSA]

    # 5. Rota para listagem do blog
    RewriteRule ^blog$ new-blog.php [L,QSA]

    # 6. Rota amigavel para posts individuais
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^blog/([^/]+)$ detalhe-newblog.php?slug=$1 [L,QSA]

    # 7. Rota do sistema
    RewriteRule ^sistema$ sistema/index.php [L,QSA]
</IfModule>

# Proteger arquivos sensiveis
<FilesMatch "^(\.env|\.git|composer\.json|composer\.lock|package\.json|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php81" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
