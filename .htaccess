DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forcar HTTPS no dominio principal
    RewriteCond %{HTTP_HOST} ^(www\.)?uppertruck\.com$ [NC]
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Bloquear metodos perigosos
    RewriteCond %{REQUEST_METHOD} ^TRACE [NC]
    RewriteRule ^ - [F]

    # Remover barra final das URLs, exceto diretorios reais
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # Blog publico
    RewriteRule ^blog$ new-blog.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^blog/([^/]+)$ detalhe-newblog.php?slug=$1 [L,QSA]

    # Sistema
    RewriteRule ^sistema$ sistema/index.php [L,QSA]
</IfModule>

<FilesMatch "^(\.env|\.git|composer\.json|composer\.lock|package\.json|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
